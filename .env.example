PORT=5000
NODE_ENV=development

MONGODB_URI=

JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Code Ground <no-reply@example.com>"

CLIENT_URL=http://localhost:5173

GEMINI_API_KEY=

# Set to false on hosts without a Docker daemon (e.g. a Render demo
# deployment). Defaults to true (Docker validation + execution routes
# behave exactly as before) when unset. See docs/16_Deployment_Demo_Mode.md.
EXECUTION_ENABLED=true
