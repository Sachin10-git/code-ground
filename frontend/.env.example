# Leave both unset for local development — the Vite dev server proxy
# (vite.config.js) already routes /api and /socket.io/* same-origin
# to the local backend. Only set these when the frontend and backend
# are deployed to different origins (e.g. frontend on Vercel, backend
# on Render). No trailing slash. See docs/16_Deployment_Demo_Mode.md.
VITE_API_URL=
VITE_SOCKET_URL=

# Set to false to disable Run / the interactive terminal in the UI —
# pair with the backend's EXECUTION_ENABLED=false on a Docker-less
# deployment. Defaults to true (identical to today) when unset.
VITE_EXECUTION_ENABLED=true
