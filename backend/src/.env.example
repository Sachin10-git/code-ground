PORT=

NODE_ENV=

MONGODB_URI=

JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Set to false on hosts without a Docker daemon (e.g. Render demo
# deployments). Defaults to true (same as local development) when unset.
# See docs/16_Deployment_Demo_Mode.md.
EXECUTION_ENABLED=true